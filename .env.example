# Copy to .env and fill before starting. Never commit .env.
CLOUDPATRON_IMAGE=ghcr.io/nekosuneprojectsforks/cloudpatron:dev
CLOUDPATRON_HTTP_HOST=patron.example.com
CLOUDPATRON_PORT=8080
BRIDGE_API_TOKEN=replace-with-openssl-rand-hex-32
DOWNLOAD_SIGNING_SECRET=replace-with-another-openssl-rand-hex-32
HELEKET_MERCHANT_ID=
HELEKET_PAYMENT_KEY=
HELEKET_CALLBACK_URL=https://patron.example.com/webhooks/heleket
CREATOR_API_KEYS_JSON=[]
