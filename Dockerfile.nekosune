# syntax=docker/dockerfile:1.6
FROM --platform=$BUILDPLATFORM golang:1.23-bookworm AS go-builder
ARG TARGETOS=linux
ARG TARGETARCH=amd64
WORKDIR /src
COPY go.mod ./
COPY *.go ./
COPY static ./static
COPY templates ./templates
COPY email ./email
RUN go mod tidy && CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -ldflags="-s -w" -o /out/cloudpatron .

FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production \
    CLOUDPATRON_HTTP_HOST=localhost \
    CLOUDPATRON_BRIDGE_URL=http://127.0.0.1:8091 \
    BRIDGE_HOST=127.0.0.1 \
    BRIDGE_PORT=8091 \
    BRIDGE_DATA_FILE=/data/payments/invoices.json
WORKDIR /app
COPY payment-bridge/package.json ./payment-bridge/
RUN cd payment-bridge && npm install --omit=dev --no-audit --no-fund
COPY payment-bridge ./payment-bridge
COPY --from=go-builder /out/cloudpatron /usr/local/bin/cloudpatron
COPY docker/start.sh /usr/local/bin/cloudpatron-start
RUN chmod 0755 /usr/local/bin/cloudpatron /usr/local/bin/cloudpatron-start \
    && mkdir -p /data/legacy /data/payments \
    && chown -R node:node /data /app
USER node
EXPOSE 8080
VOLUME ["/data"]
WORKDIR /app/payment-bridge
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 CMD node -e "fetch('http://127.0.0.1:8080/').then(r=>process.exit(r.status<500?0:1)).catch(()=>process.exit(1))"
ENTRYPOINT ["/usr/local/bin/cloudpatron-start"]
